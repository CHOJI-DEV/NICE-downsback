# Configuration du serveur
PORT=3001
NODE_ENV=production

# Base de données (Vercel utilise /tmp)
DB_PATH=/tmp/nice_downs.db

# JWT Secret (CHANGEZ CETTE VALEUR - Générez une clé secrète forte)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-2024

# Admin par défaut (CHANGEZ CES VALEURS IMMÉDIATEMENT)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# CORS (Remplacez par votre domaine Vercel)
ALLOWED_ORIGINS=https://your-app-name.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
